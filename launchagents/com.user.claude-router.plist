<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.claude-router</string>
  <key>ProgramArguments</key>
  <array>
    <!-- NOTE: install.sh rewrites these two paths with the real python3 + router location. -->
    <string>/usr/bin/python3</string>
    <string>/Users/REPLACE_ME/.local/share/claude-router/router.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ROUTER_PORT</key><string>8787</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/Users/REPLACE_ME/Library/Logs/claude-router.log</string>
  <key>StandardOutPath</key><string>/Users/REPLACE_ME/Library/Logs/claude-router.log</string>
</dict>
</plist>
